#!/bin/bash
set -u
RUNNER_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REAL_WINESERVER="$RUNNER_DIR/files/bin/wineserver"
ORIGINAL_PREFIX="${WINEPREFIX-}"
STATE_DIR="/run/umu-batocera"
LOG_DIR="/userdata/system/logs/umu-runner"
mkdir -p "$LOG_DIR" 2>/dev/null || true
STOP_LOG="$LOG_DIR/wineserver-stop.log"
wlog() { printf '%s %s\n' "$(date -Is 2>/dev/null || date)" "$*" >> "$STOP_LOG"; }
canon_path() { readlink -f "$1" 2>/dev/null || printf '%s' "$1"; }

case " ${*:-} " in
    *" -k "*|*" -w "*)
        request_canon=""
        [ -n "$ORIGINAL_PREFIX" ] && request_canon="$(canon_path "$ORIGINAL_PREFIX")"
        state=""
        match_kind=""
        runner_candidate=""
        runner_candidates=0

        if [ -d "$STATE_DIR" ]; then
            for f in "$STATE_DIR"/session-*.state; do
                [ -f "$f" ] || continue
                state_pid="$(sed -n '6p' "$f" 2>/dev/null)"
                # Drop abandoned mappings, but never reject a live mapping just
                # because a child process has moved into pressure-vessel.
                if [ -n "$state_pid" ] && ! kill -0 "$state_pid" 2>/dev/null; then
                    rm -f "$f" 2>/dev/null || true
                    continue
                fi
                mapped_runner="$(sed -n '5p' "$f" 2>/dev/null)"
                [ "$mapped_runner" = "$RUNNER_DIR" ] || continue

                raw="$(sed -n '1p' "$f" 2>/dev/null)"
                canonical="$(sed -n '2p' "$f" 2>/dev/null)"
                alias="$(sed -n '3p' "$f" 2>/dev/null)"
                raw_canon=""; alias_canon=""
                [ -n "$raw" ] && raw_canon="$(canon_path "$raw")"
                [ -n "$alias" ] && alias_canon="$(canon_path "$alias")"

                if [ -n "$ORIGINAL_PREFIX" ] && [ "$ORIGINAL_PREFIX" = "$raw" ]; then
                    state="$f"; match_kind="raw"; break
                elif [ -n "$request_canon" ] && { [ "$request_canon" = "$canonical" ] || [ "$request_canon" = "$raw_canon" ] || [ -n "$alias_canon" -a "$request_canon" = "$alias_canon" ]; }; then
                    state="$f"; match_kind="canonical"; break
                fi

                runner_candidate="$f"
                runner_candidates=$((runner_candidates+1))
            done
        fi

        if [ -z "$state" ] && [ "$runner_candidates" -eq 1 ]; then
            state="$runner_candidate"
            match_kind="runner-unique"
        fi

        if [ -n "$state" ]; then
            mapped_prefix="$(sed -n '4p' "$state" 2>/dev/null)"
            mapped_runner="$(sed -n '5p' "$state" 2>/dev/null)"
            if [ "$mapped_runner" = "$RUNNER_DIR" ] && [ -d "$mapped_prefix" ]; then
                export WINEPREFIX="$mapped_prefix"
                wlog "state_match=$match_kind action=$* original=${ORIGINAL_PREFIX:-<unset>} effective=$mapped_prefix state=$state runner=$RUNNER_DIR"
            else
                wlog "state_rejected action=$* state=$state original=${ORIGINAL_PREFIX:-<unset>} runner=$RUNNER_DIR"
            fi
        else
            wlog "no_state action=$* original=${ORIGINAL_PREFIX:-<unset>} canonical=${request_canon:-<unset>} candidates=$runner_candidates runner=$RUNNER_DIR"
        fi
        ;;
esac
# Waiting only for Wine lets Batocera remove its OverlayFS workdir while the
# host wrapper is still persisting the prefix. Hold native -w until that host
# session has completed its return. Internal Proton waits and uncertain
# runner-only matches must not wait for their own parent launch wrapper.
case " ${*:-} " in
    *" -w "*)
        if [ -n "${state:-}" ] && { [ "${match_kind:-}" = raw ] || [ "${match_kind:-}" = canonical ]; } \
                && [ "${WINEPREFIX:-}" = "${mapped_prefix:-}" ]; then
            state_pid="$(sed -n '6p' "$state" 2>/dev/null)"
            state_token="$(sed -n '7p' "$state" 2>/dev/null)"
            if [ -n "$state_token" ]; then
                "$REAL_WINESERVER" "$@"
                server_rc=$?
                wlog "runtime_wait_begin owner=$state_pid state=$state"
                python3 "$RUNNER_DIR/umu-batocera/runtime-prefix.py" wait-owner \
                    --state-file "$state" --pid "$state_pid" --owner-token "$state_token" >>"$STOP_LOG" 2>&1 || {
                    wlog "runtime_wait_failed owner=$state_pid"; exit 1;
                }
                wlog "runtime_wait_end owner=$state_pid"
                exit "$server_rc"
            fi
        fi
        ;;
esac
exec "$REAL_WINESERVER" "$@"
