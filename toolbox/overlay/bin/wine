#!/bin/bash
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNNER_DIR="$(cd "$SELF_DIR/.." && pwd)"
REAL_WINE="$RUNNER_DIR/files/bin/wine"
UMU_RUN="/userdata/system/umu/umu-run"
UMU_HOME="/userdata/system/umu/home"
UMU_CACHE="/userdata/system/umu/cache"
ROOT_BRIDGE="$RUNNER_DIR/umu-batocera/umu-root-runner.py"
LOG_DIR="/userdata/system/logs/umu-runner"
COMPAT_ROOT="/userdata/system/umu/compatdata"
mkdir -p "$LOG_DIR" "$UMU_HOME" "$UMU_CACHE" "$COMPAT_ROOT"

# Keep runner diagnostics bounded even if the Toolbox maintenance menu is never opened.
find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type f -name '*.log' -mtime +30 -delete 2>/dev/null || true
mapfile -t _umu_old_logs < <(find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' 2>/dev/null | sort -nr | sed 's/^[^ ]* //')
for ((_umu_i=19; _umu_i<${#_umu_old_logs[@]}; _umu_i++)); do
    rm -f -- "${_umu_old_logs[$_umu_i]}" 2>/dev/null || true
done
unset _umu_old_logs _umu_i

stamp="$(date '+%Y%m%d-%H%M%S')"
LOG="$LOG_DIR/runner-$stamp-$$.log"
log() { printf '%s\n' "$*" >> "$LOG"; }

ORIGINAL_WINEPREFIX="${WINEPREFIX-}"
# Opt-in path compatibility; only the literal value 1 enables it.
UMU_DIRECT_GAME_ENABLED=0
[ "${UMU_DIRECT_GAME:-0}" != 1 ] || UMU_DIRECT_GAME_ENABLED=1
unset UMU_DIRECT_GAME
log "umu_direct_game=$UMU_DIRECT_GAME_ENABLED"

# Batocera builds may omit the mountpoint executable.
mountpoint() { [ "${1:-}" = -q ] && shift; findmnt -rn -M "$1" >/dev/null 2>&1; }

# v3.10.3: HIDRAW must preserve native Sony controller support. Do not
# enable the Sony-to-XInput compatibility bridge merely because HIDRAW is on.
# Explicit user settings and Proton's own per-game presets remain authoritative.
SONY_HIDRAW_XINPUT="${PROTON_SONY_HIDRAW_XINPUT:-runner-default}"

# v3.7.1: runner isolation. Proton prefixes can contain absolute symlinks back
# into older GE-Proton distributions. When another Proton version migrates the
# same prefix it may follow those links and overwrite the older runner itself.
# Protect every managed *-UMU runner read-only for the whole application launch,
# not only the selected runner: the victim can be a different historical runner.
UMU_PROTECTED_MOUNTS=()

runner_manifest_ok() {
    local r="$1" m
    m="$r/umu-batocera/integrity.sha256"
    [ -s "$m" ] || return 2
    (cd "$r" && sha256sum -c "$m" >/dev/null 2>&1)
}

protect_all_umu_runners_ro() {
    local r opts
    for r in /userdata/system/wine/custom/*-UMU; do
        [ -d "$r" ] || continue

        # Refuse the selected runner only. Historical runners remain read-only
        # even when corrupt, since old prefix links can still refer to them.
        if [ -s "$r/umu-batocera/integrity.sha256" ]; then
            if ! runner_manifest_ok "$r"; then
                if [ "$(readlink -f "$r")" = "$RUNNER_DIR" ]; then
                    log "FATAL: integrity mismatch: $r"
                    return 90
                fi
                log "WARNING: unrelated_runner_integrity_mismatch=$r"
            else
                log "integrity_ok=$r"
            fi
        else
            log "integrity_unmanaged=$r"
        fi

        opts="$(findmnt -n -o OPTIONS -T "$r" 2>/dev/null || true)"
        if mountpoint -q "$r" 2>/dev/null; then
            case ",$opts," in
                *,ro,*) log "runner_already_ro=$r"; continue ;;
                *) log "FATAL: runner is an existing writable mountpoint: $r"; return 91 ;;
            esac
        fi

        if ! mount --bind "$r" "$r" 2>>"$LOG"; then
            log "FATAL: bind protection failed: $r"
            return 92
        fi
        if ! mount -o remount,bind,ro "$r" 2>>"$LOG"; then
            umount "$r" 2>>"$LOG" || true
            log "FATAL: read-only remount failed: $r"
            return 93
        fi
        UMU_PROTECTED_MOUNTS+=("$r")
        log "runner_protected_ro=$r"
    done
    return 0
}

unprotect_umu_runners() {
    local i r attempt unmounted
    for ((i=${#UMU_PROTECTED_MOUNTS[@]}-1; i>=0; i--)); do
        r="${UMU_PROTECTED_MOUNTS[$i]}"
        unmounted=0
        # v3.9.3: a direct .pc prefix can leave the runner busy for a very short
        # time while Proton/pressure-vessel is winding down. Retry normal
        # unmounts first; only then use the existing lazy-unmount fallback.
        for attempt in 1 2 3 4 5; do
            if umount "$r" 2>>"$LOG"; then
                unmounted=1
                break
            fi
            sleep 0.2
        done
        if [ "$unmounted" -eq 0 ]; then
            if umount -l "$r" 2>>"$LOG"; then
                unmounted=1
                log "runner_unprotected_lazy=$r"
            fi
        fi
        if mountpoint -q "$r" 2>/dev/null; then
            log "WARNING: runner_unprotect_failed=$r"
        elif [ "$unmounted" -eq 1 ]; then
            log "runner_unprotected=$r"
        else
            log "runner_unprotected_already=$r"
        fi
    done
    UMU_PROTECTED_MOUNTS=()
}

log "===== Batocera UMU runner v3.10.9 ====="
log "date=$(date -Is 2>/dev/null || date)"
log "uid=$(id)"
log "runner=$RUNNER_DIR"
log "pwd=$PWD"
log "batocera_wineprefix=$ORIGINAL_WINEPREFIX"
log "DISPLAY=${DISPLAY-}"
log "WAYLAND_DISPLAY=${WAYLAND_DISPLAY-}"
log "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR-}"
log "wine_enable_hidraw=${WINE_ENABLE_HIDRAW:-0}"
log "sony_hidraw_xinput=$SONY_HIDRAW_XINPUT"
log "argv_count=$#"
i=0; for a in "$@"; do log "argv[$i]=$a"; i=$((i+1)); done

win_to_unix() {
    local p="$1"
    case "$p" in
        [Zz]:\\*|[Ss]:\\*)
            p="/${p:3}"
            p="${p//\\//}"
            printf '%s' "$p"
            return 0
            ;;
    esac
    printf '%s' "$p"
}

is_prefix_root() {
    [ -n "$1" ] && [ -d "$1/drive_c" ] && [ -f "$1/system.reg" ] && [ -f "$1/user.reg" ]
}

find_embedded_prefix() {
    local d="$1" n=0
    [ -f "$d" ] && d="$(dirname "$d")"
    while [ -n "$d" ] && [ "$d" != "/" ] && [ "$n" -lt 16 ]; do
        if is_prefix_root "$d"; then
            printf '%s' "$d"
            return 0
        fi
        d="$(dirname "$d")"
        n=$((n+1))
    done
    return 1
}

# Find the executable Batocera wants Wine to start.
#
# Maintenance helpers stay on the ordinary Wine path so Batocera can perform
# prefix setup without starting a full Proton/UMU session.
#
# v3.3 IMPORTANT: explorer.exe / winefile.exe are NOT launched inside Wine.
# Starting the game as a child of Explorer gives Proton/UMU a different primary
# executable context (EXE, install path, caches, media behaviour, process tree).
# Instead, when Batocera requests Explorer because autorun.cmd is absent, we show
# a native Batocera file chooser, then reinvoke this wrapper with the selected EXE.
# The selected game therefore becomes the primary UMU application exactly like
# an autorun.cmd launch.

select_game_exe() {
    local prefix="$1"
    local start="${prefix:+$prefix/drive_c}"
    [ -d "$start" ] || start="${prefix:-$PWD}"
    [ -d "$start" ] || start="$PWD"

    local title="Choisir l'executable Windows a lancer avec UMU / GE-Proton"
    local selected=""

    if command -v yad >/dev/null 2>&1; then
        selected="$(yad --file-selection \
            --title="$title" \
            --filename="$start/" \
            --file-filter='Executables Windows (*.exe)|*.exe *.EXE' \
            --file-filter='Tous les fichiers|*' 2>>"$LOG" || true)"
    elif command -v zenity >/dev/null 2>&1; then
        selected="$(zenity --file-selection \
            --title="$title" \
            --filename="$start/" \
            --file-filter='Executables Windows (*.exe) | *.exe *.EXE' 2>>"$LOG" || true)"
    else
        log "selector_error=no-yad-or-zenity"
        return 127
    fi

    [ -n "$selected" ] || return 125
    case "$(printf '%s' "$selected" | tr '[:upper:]' '[:lower:]')" in
        *.exe) ;;
        *)
            log "selector_error=selected-file-is-not-exe"
            log "selector_selected=$selected"
            return 126
            ;;
    esac

    printf '%s' "$selected"
}
exe=""
exe_index=-1
interactive_shell=0
idx=0
for arg in "$@"; do
    cand="$(win_to_unix "$arg")"
    low="$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')"
    base="$(basename "${low//\//}")"
    case "$base" in
        explorer.exe|winefile.exe)
            interactive_shell=1
            exe_index=$idx
            break
            ;;
    esac
    case "$low" in
        *.exe|*.com|*.bat|*.cmd)
            case "$base" in
                wineboot.exe|winecfg.exe|regedit.exe|regsvr32.exe|rundll32.exe|control.exe|cmd.exe|start.exe)
                    ;;
                *) exe="$cand"; exe_index=$idx; break ;;
            esac
            ;;
    esac
    idx=$((idx+1))
done

if [ "$interactive_shell" -eq 1 ]; then
    log "launch_kind=manual-selector"
    log "selector_prefix=$ORIGINAL_WINEPREFIX"
    selected="$(select_game_exe "$ORIGINAL_WINEPREFIX")"
    selrc=$?
    if [ "$selrc" -eq 125 ]; then
        log "selector=cancelled"
        exit 0
    elif [ "$selrc" -ne 0 ]; then
        log "selector=failed rc=$selrc"
        exit "$selrc"
    fi
    log "selector_selected=$selected"
    # Re-enter the wrapper with the real game executable. WINEPREFIX and all
    # Batocera environment variables are preserved, but the game now becomes
    # UMU's primary EXE (same path as autorun.cmd).
    exec "$0" "$selected"
fi

if [ -z "$exe" ]; then
    # Pure informational calls do not initialize or migrate a prefix.
    if [ "$#" -eq 1 ]; then
        case "$1" in --version|--help) exec "$REAL_WINE" "$@" ;; esac
    fi
    log "mode=fallback-real-wine"
    # wineboot/regedit/winecfg also migrate DLLs. These calls must not bypass
    # isolation when run by Batocera or manually outside EmulationStation.
    trap unprotect_umu_runners EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    if ! protect_all_umu_runners_ro; then
        log "ERROR: maintenance isolation failed; Wine call refused"
        exit 90
    fi
    if is_prefix_root "$ORIGINAL_WINEPREFIX"; then
        if ! python3 "$RUNNER_DIR/umu-batocera/prefix-isolation.py" "$ORIGINAL_WINEPREFIX" \
            --runners "$(dirname "$RUNNER_DIR")" >>"$LOG" 2>&1; then
            log "FATAL: maintenance prefix isolation failed"
            exit 94
        fi
    fi
    "$REAL_WINE" "$@"
    maintenance_rc=$?
    # Prefix initialization can leave background Wine helpers alive. Wait for
    # this prefix's wineserver before removing mounts owned by this wrapper.
    "$RUNNER_DIR/files/bin/wineserver" -w >>"$LOG" 2>&1
    log "maintenance_exit=$maintenance_rc"
    exit "$maintenance_rc"
fi

args=("$@")
launch_args=()
if [ "$exe_index" -ge 0 ]; then
    j=$((exe_index+1))
    while [ "$j" -lt "${#args[@]}" ]; do
        launch_args+=("${args[$j]}")
        j=$((j+1))
    done
fi

case "$exe" in
    /*) EXE_ABS="$exe" ;;
    *)  EXE_ABS="$PWD/$exe" ;;
esac
EXE_ABS="$(readlink -f "$EXE_ABS" 2>/dev/null || printf '%s' "$EXE_ABS")"

# v3.6: Batocera already builds the correct writable overlay for compressed
# .wsquashfs games under /run/wine.  Do not replace that overlay with a raw
# wine-bottle.  Instead expose the *merged overlay* through a stable path under
# /userdata so pressure-vessel can use it without the reserved-/var/run warning.
# Writes still go to Batocera's own upperdir/wine-bottle.
PFX_BOUND=0
ALIAS_BOUND=0
PFX_MOUNT=""
ALIAS_MOUNT=""
GAMEVIEW_BOUND=0
GAMEVIEW_TARGET=""
GAMEVIEW_MOUNTPOINT_CREATED=0
C_GAME_PATH_BOUND=0
C_GAME_PATH_TARGET=""
C_GAME_PATH_CREATED=0
ACTIVE_STATE_FILE=""
RUNTIME_TRACKED=0
RUNTIME_SAFE_TO_REMOVE=1
RUNTIME_REUSED=0
RUNTIME_HELPER="$RUNNER_DIR/umu-batocera/runtime-prefix.py"

# Direct mode only: use real save files on the game's own filesystem.
# Keep the original save target intact until a complete return copy is ready.
DIRECT_SAVE_PATH=""
DIRECT_SAVE_BACKUP=""
DIRECT_SAVE_SOURCE=""
DIRECT_SAVE_MOVED=0

restore_direct_save_link() {
    [ "$DIRECT_SAVE_MOVED" -eq 1 ] || return 0
    if mountpoint -q "$DIRECT_SAVE_PATH" || [ -L "$DIRECT_SAVE_PATH" ]; then
        log "WARNING: direct_save_restore_refused=$DIRECT_SAVE_PATH"
        return 1
    fi
    # Stage all data first. Keep the previous persistent directory until
    # restoration succeeds, and roll back a failed replacement. On any failure,
    # leave the local saves and the original symlink backup untouched.
    if ! python3 - "$DIRECT_SAVE_PATH" "$DIRECT_SAVE_SOURCE" >>"$LOG" 2>&1 <<'DIRECT_SAVE_SYNC'
from pathlib import Path
import os
import shutil
import sys
import tempfile

local, target = map(Path, sys.argv[1:])
previous = target.with_name(target.name + '.umu-direct-previous')
if local.is_symlink() or not local.is_dir() or target.is_symlink() or not target.is_dir():
    raise RuntimeError('unsafe or missing save directory; local saves retained')
if os.path.ismount(target):
    raise RuntimeError('persistent save target is a mountpoint; local saves retained')
work = Path(tempfile.mkdtemp(prefix='.' + target.name + '.umu-direct-stage-', dir=target.parent))
stage = work / 'saves'
try:
    shutil.copytree(local, stage, symlinks=True,
                    ignore=lambda folder, names: ['.umu-direct-previous'] if Path(folder) == local else [])
    # A previous snapshot belongs to this opt-in save target only. Refuse
    # unexpected types instead of following a symlink or deleting a mount.
    if previous.exists() or previous.is_symlink():
        if previous.is_symlink() or not previous.is_dir() or os.path.ismount(previous):
            raise RuntimeError('unsafe previous save snapshot; local saves retained')
        shutil.rmtree(previous)
    target.rename(previous)
    try:
        stage.rename(target)
    except BaseException:
        if not target.exists():
            previous.rename(target)
        raise
finally:
    shutil.rmtree(work, ignore_errors=True)
DIRECT_SAVE_SYNC
    then
        log "WARNING: direct_save_sync_failed=$DIRECT_SAVE_PATH source=$DIRECT_SAVE_SOURCE"
        return 1
    fi
    log "direct_save_sync=ok"
    # Retain local data until the symlink itself has been restored successfully.
    local retired="$DIRECT_SAVE_PATH.umu-direct-local"
    if [ -e "$retired" ] || [ -L "$retired" ]; then
        log "WARNING: direct_save_local_backup_exists=$retired"; return 1
    fi
    mv -- "$DIRECT_SAVE_PATH" "$retired" 2>>"$LOG" || return 1
    if ! mv -- "$DIRECT_SAVE_BACKUP" "$DIRECT_SAVE_PATH" 2>>"$LOG"; then
        mv -- "$retired" "$DIRECT_SAVE_PATH" 2>>"$LOG" || true
        log "WARNING: direct_save_restore_failed=$DIRECT_SAVE_PATH"
        return 1
    fi
    DIRECT_SAVE_MOVED=0
    log "direct_save_link_restored=$DIRECT_SAVE_PATH"
    # Store one previous generation inside the game's save directory. Never
    # include that snapshot in the next launch copy or nest snapshots forever.
    python3 - "$retired" "$DIRECT_SAVE_SOURCE" >>"$LOG" 2>&1 <<'DIRECT_SAVE_REMOVE'
from pathlib import Path
import os
import shutil
import sys
retired, target = map(Path, sys.argv[1:])
previous = target.with_name(target.name + '.umu-direct-previous')
nested = previous / '.umu-direct-previous'
backup = target / '.umu-direct-previous'
for path in (retired, previous, nested, backup):
    if path.is_symlink() or os.path.ismount(path):
        raise RuntimeError('refusing unsafe recovery cleanup: ' + str(path))
if nested.exists():
    shutil.rmtree(nested)
if backup.exists():
    raise RuntimeError('unexpected snapshot in current saves; previous snapshot retained')
previous.rename(backup)
shutil.rmtree(retired)
DIRECT_SAVE_REMOVE
}

prepare_direct_save_copy() {
    [ "$UMU_DIRECT_GAME_ENABLED" -eq 1 ] || return 0
    [ -n "${GAME_SOURCE:-}" ] || return 0
    local prefix autorun line savedir="" path parent source game_root
    prefix="$ORIGINAL_PREFIX_CANON"
    [ "$COMPRESSED_OVERLAY" -eq 0 ] || prefix="$ALIAS_MOUNT"
    autorun="$prefix/autorun.cmd"
    [ -f "$autorun" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in SAVEDIR=*) savedir="${line#SAVEDIR=}" ;; esac
    done < "$autorun"
    savedir="${savedir#\"}"; savedir="${savedir%\"}"
    savedir="${savedir%/}"
    case "$savedir" in
        ""|.|/*|..|../*|*/../*|*/..) return 0 ;;
    esac
    path="$prefix/$savedir"
    # Restrict conversion to the external game directory, which is excluded
    # from prefix materialization/persistence. Do not touch prefix-side saves.
    game_root="$(readlink -f "$GAME_SOURCE")" || return 1
    parent="$(readlink -f "$(dirname "$path")")" || return 1
    case "$parent/" in "$game_root/"*) ;; *) return 0 ;; esac
    path="$parent/$(basename "$path")"
    if [ -e "$path.umu-direct-link" ] || [ -L "$path.umu-direct-link" ]; then
        log "ERROR: direct_save_backup_exists=$path.umu-direct-link"; return 1
    fi
    [ -L "$path" ] || return 0
    source="$(readlink -f "$path")" || return 1
    case "$source" in /userdata/saves/windows/*) ;; *)
        log "ERROR: direct_save_unexpected_target=$source"; return 1 ;;
    esac
    [ -d "$source" ] || { log "ERROR: direct_save_target_missing=$source"; return 1; }
    # Copy beside the save path before touching the link. Partial copies can
    # never be used as authoritative saves or written back on a failed start.
    local work
    work="$(mktemp -d "$parent/.umu-direct-save.XXXXXX")" || return 1
    local item copy_failed=0
    for item in "$source"/* "$source"/.[!.]* "$source"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        [ "$(basename "$item")" != .umu-direct-previous ] || continue
        cp -a -- "$item" "$work/" 2>>"$LOG" || { copy_failed=1; break; }
    done
    if [ "$copy_failed" -eq 1 ]; then
        rm -rf -- "$work"
        log "ERROR: direct_save_copy_failed=$source"; return 1
    fi
    if [ -e "$path.umu-direct-local" ] || [ -L "$path.umu-direct-local" ]; then
        rm -rf -- "$work"
        log "ERROR: direct_save_local_backup_exists=$path.umu-direct-local"; return 1
    fi
    DIRECT_SAVE_PATH="$path"
    DIRECT_SAVE_BACKUP="$path.umu-direct-link"
    DIRECT_SAVE_SOURCE="$source"
    if ! mv -- "$path" "$DIRECT_SAVE_BACKUP" 2>>"$LOG"; then
        rm -rf -- "$work"; return 1
    fi
    if ! mv -- "$work" "$path" 2>>"$LOG"; then
        mv -- "$DIRECT_SAVE_BACKUP" "$path" 2>>"$LOG" || true
        rm -rf -- "$work"; return 1
    fi
    DIRECT_SAVE_MOVED=1
    log "direct_save_copy=1"
    log "direct_save_path=$path"
    log "direct_save_source=$source"
}

expose_c_game_path() {
    local requested="${UMU_C_GAME_PATH:-1}" target name
    unset UMU_C_GAME_PATH
    case "$requested" in 0) log "runtime_c_game_enabled=0"; return 0 ;; esac
    log "runtime_c_game_enabled=1"
    # Only split prefixes have an excluded game directory to expose. Ordinary
    # .pc/standalone prefixes retain their existing drive layout.
    [ -n "${MATERIALIZED_PREFIX:-}" ] && [ -n "${GAMEVIEW:-}" ] || return 0
    [ "${PFX_BOUND:-0}" -eq 1 ] && [ -d "$PFX_MOUNT/drive_c" ] || return 1
    name="${GAME_DIR:-}"
    case "$name" in ''|.|..|*/*|*\\*) log "ERROR: unsafe C game directory name"; return 1 ;; esac
    [ "${GAME_REL:-}" = "drive_c/$name" ] || return 1
    case "${name,,}" in windows|users|programdata|system32|syswow64)
        log "ERROR: refusing system directory for C game view: $name"; return 1 ;;
    esac
    [ -d "$GAMEVIEW" ] && [ ! -L "$PFX_MOUNT/drive_c" ] || return 1
    target="$PFX_MOUNT/$GAME_REL"
    # The game was excluded from materialization. Never hide existing files,
    # follow an alias, reuse a stale mount or replace a real game directory.
    if [ -e "$target" ] || [ -L "$target" ]; then
        log "ERROR: C game target already exists: $target"; return 1
    fi
    mkdir -- "$target" || return 1
    C_GAME_PATH_CREATED=1
    C_GAME_PATH_TARGET="$target"
    # Mount AFTER the pfx bind: a plain parent bind does not carry submounts.
    # A directory bind also avoids Wine resolving a Unix symlink back to S:.
    if ! mount --bind "$GAMEVIEW" "$target" 2>>"$LOG"; then
        log "ERROR: C game bind failed: $GAMEVIEW -> $target"; return 1
    fi
    C_GAME_PATH_BOUND=1
    log "runtime_c_game_source=$GAMEVIEW"
    log "runtime_c_game_target=$target"
    log "runtime_c_game_windows=C:\\$name"
    # Direct mode intentionally keeps its original EXE/CWD paths, while the
    # same C: view remains available to launchers and saved path settings.
    if [ "$UMU_DIRECT_GAME_ENABLED" -eq 0 ]; then
        case "$EXE_ABS" in "$GAMEVIEW"/*) EXE_ABS="$target/${EXE_ABS#"$GAMEVIEW"/}" ;; *) return 1 ;; esac
        case "${UMU_CWD:-}" in
            "$GAMEVIEW") UMU_CWD="$target" ;;
            "$GAMEVIEW"/*) UMU_CWD="$target/${UMU_CWD#"$GAMEVIEW"/}" ;;
            *) UMU_CWD="$target" ;;
        esac
        log "runtime_c_game_exe=$EXE_ABS"
        log "runtime_c_game_cwd=$UMU_CWD"
    fi
    return 0
}

cleanup_c_game_path() {
    if [ "${C_GAME_PATH_BOUND:-0}" -eq 1 ]; then
        if ! umount "$C_GAME_PATH_TARGET" 2>>"$LOG" && ! umount -l "$C_GAME_PATH_TARGET" 2>>"$LOG"; then
            log "WARNING: C game unmount failed: $C_GAME_PATH_TARGET"; return 1
        fi
        if mountpoint -q "$C_GAME_PATH_TARGET"; then
            log "WARNING: C game view remains mounted: $C_GAME_PATH_TARGET"; return 1
        fi
        C_GAME_PATH_BOUND=0
        log "runtime_c_game_unmounted=$C_GAME_PATH_TARGET"
    fi
    if [ "${C_GAME_PATH_CREATED:-0}" -eq 1 ] && [ -n "${C_GAME_PATH_TARGET:-}" ]; then
        # rmdir only: never recurse into the game or delete a non-empty path.
        rmdir -- "$C_GAME_PATH_TARGET" 2>>"$LOG" || true
        C_GAME_PATH_CREATED=0
    fi
    return 0
}

cleanup_runtime_mounts() {
    # Never keep a runtime bind busy because this wrapper shell is still cwd inside it.
    cd /userdata 2>>"$LOG" || cd / 2>>"$LOG" || true
    restore_direct_save_link || RUNTIME_SAFE_TO_REMOVE=0
    cleanup_c_game_path || true
    if [ -n "${ACTIVE_STATE_FILE:-}" ]; then
        rm -f "$ACTIVE_STATE_FILE" 2>>"$LOG" || true
        log "runtime_active_state_removed=$ACTIVE_STATE_FILE"
        ACTIVE_STATE_FILE=""
    fi
    if [ "${PFX_BOUND:-0}" -eq 1 ] && [ -n "${PFX_MOUNT:-}" ]; then
        umount "$PFX_MOUNT" 2>>"$LOG" || umount -l "$PFX_MOUNT" 2>>"$LOG" || true
        PFX_BOUND=0
    fi
    if [ "${GAMEVIEW_BOUND:-0}" -eq 1 ] && [ -n "${GAMEVIEW_TARGET:-}" ]; then
        if umount "$GAMEVIEW_TARGET" 2>>"$LOG" || umount -l "$GAMEVIEW_TARGET" 2>>"$LOG"; then
            if mountpoint -q "$GAMEVIEW_TARGET" 2>/dev/null; then
                log "WARNING: runtime_gameview_still_mounted=$GAMEVIEW_TARGET"
            else
                log "runtime_gameview_unmounted=$GAMEVIEW_TARGET"
            fi
        else
            log "WARNING: runtime_gameview_unmount_failed=$GAMEVIEW_TARGET"
        fi
        GAMEVIEW_BOUND=0
        if [ "${GAMEVIEW_MOUNTPOINT_CREATED:-0}" -eq 1 ] && ! mountpoint -q "$GAMEVIEW_TARGET" 2>/dev/null; then
            rmdir "$GAMEVIEW_TARGET" 2>>"$LOG" || true
        fi
    fi
    if [ "${ALIAS_BOUND:-0}" -eq 1 ] && [ -n "${ALIAS_MOUNT:-}" ]; then
        umount "$ALIAS_MOUNT" 2>>"$LOG" || umount -l "$ALIAS_MOUNT" 2>>"$LOG" || true
        ALIAS_BOUND=0
    fi
    unprotect_umu_runners
    if [ "${RUNTIME_TRACKED:-0}" -eq 1 ]; then
        local -a finish_args=()
        [ "$RUNTIME_SAFE_TO_REMOVE" -ne 1 ] || finish_args+=(--safe)
        python3 "$RUNTIME_HELPER" finish "$MATERIALIZED_PREFIX" --pid "$$" "${finish_args[@]}" >>"$LOG" 2>&1 || \
            log "WARNING: runtime cleanup refused; prefix retained=$MATERIALIZED_PREFIX"
        RUNTIME_TRACKED=0
    fi
}
trap cleanup_runtime_mounts EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

prepare_materialized_prefix() {
    local begin_rc
    # Hold the lock throughout copying, launch, persistence and mount cleanup.
    # Child processes inherit it, so a killed parent cannot expose a live copy
    # to the next launcher. Manual runtime cleanup probes the same lock.
    exec 8>/userdata/system/umu/.materialized-prefix.lock || return 1
    flock -n 8 || { log "ERROR: another materialized-prefix session is active"; return 1; }
    python3 "$RUNTIME_HELPER" begin "$MATERIALIZED_PREFIX" \
        --source "$ORIGINAL_PREFIX_CANON" --game-dir "$GAME_DIR" --pid "$$" >>"$LOG" 2>&1
    begin_rc=$?
    case "$begin_rc" in
        0) RUNTIME_REUSED=0;;
        10) RUNTIME_REUSED=1; RUNTIME_SAFE_TO_REMOVE=0;;
        *) return 1;;
    esac
    RUNTIME_TRACKED=1
    mkdir -p "$MATERIALIZED_PREFIX/drive_c" || return 1
}

check_materialized_space() {
    [ "${RUNTIME_REUSED:-0}" -eq 0 ] || return 0
    local item name needed available
    local -a items=()
    for item in "$ORIGINAL_PREFIX_CANON"/* "$ORIGINAL_PREFIX_CANON"/.[!.]* "$ORIGINAL_PREFIX_CANON"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        [ "$(basename "$item")" = drive_c ] || items+=("$item")
    done
    for item in "$ORIGINAL_PREFIX_CANON/drive_c"/* "$ORIGINAL_PREFIX_CANON/drive_c"/.[!.]* "$ORIGINAL_PREFIX_CANON/drive_c"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        name="$(basename "$item")"
        [ "$name" = "$GAME_DIR" ] && continue
        [ -n "${UWT_GAME_BACKUP_NAME:-}" ] && [ "$name" = "$UWT_GAME_BACKUP_NAME" ] && continue
        items+=("$item")
    done
    [ "${#items[@]}" -gt 0 ] || return 1
    needed="$(set -o pipefail; du -sk -- "${items[@]}" 2>>"$LOG" | awk '{n+=$1} END {printf "%.0f", n}')" || return 1
    available="$(df -Pk "$MATERIALIZED_PREFIX" 2>>"$LOG" | awk 'NR==2 {print $4}')"
    case "$needed:$available" in *[!0-9:]*|:*|*:) log "ERROR: cannot estimate runtime free space"; return 1;; esac
    log "runtime_space_needed_kib=$needed available_kib=$available reserve_kib=262144"
    [ "$available" -ge "$((needed+262144))" ] || {
        log "ERROR: insufficient free space for materialized prefix (256 MiB reserve); launch refused"
        return 1
    }
}

if ! protect_all_umu_runners_ro; then
    log "ERROR: UMU runner isolation could not be established; launch refused"
    exit 90
fi

EFFECTIVE_WINEPREFIX="$ORIGINAL_WINEPREFIX"
IDENTITY_ANCHOR=""
COMPRESSED_OVERLAY=0
ORIGINAL_PREFIX_CANON="$(readlink -f "$ORIGINAL_WINEPREFIX" 2>/dev/null || printf '%s' "$ORIGINAL_WINEPREFIX")"

case "$(printf '%s' "$ORIGINAL_WINEPREFIX" | tr '[:upper:]' '[:lower:]')" in
    /run/wine/*.wsquashfs|/var/run/wine/*.wsquashfs|/run/wine/*.wtgz|/var/run/wine/*.wtgz)
        if [ "$(findmnt -n -o FSTYPE -T "$ORIGINAL_WINEPREFIX" 2>/dev/null || true)" = "overlay" ]; then
            COMPRESSED_OVERLAY=1
            compressed_anchor="$(basename "$ORIGINAL_WINEPREFIX")"
            alias_safe="$(printf '%s' "$compressed_anchor" | tr -c 'A-Za-z0-9._-' '_')"
            alias_key="$(printf 'compressed-overlay|%s' "$compressed_anchor" | cksum | awk '{print $1}')"
            ALIAS_MOUNT="/userdata/system/umu/merged-prefixes/${alias_safe}-${alias_key}"
            mkdir -p "$ALIAS_MOUNT"
            if mountpoint -q "$ALIAS_MOUNT" 2>/dev/null; then
                umount "$ALIAS_MOUNT" 2>>"$LOG" || umount -l "$ALIAS_MOUNT" 2>>"$LOG" || true
            fi
            if ! mount --bind "$ORIGINAL_PREFIX_CANON" "$ALIAS_MOUNT" 2>>"$LOG"; then
                log "ERROR: compressed overlay alias bind failed: $ORIGINAL_PREFIX_CANON -> $ALIAS_MOUNT"
                exit 76
            fi
            ALIAS_BOUND=1
            EFFECTIVE_WINEPREFIX="$ALIAS_MOUNT"
            IDENTITY_ANCHOR="$compressed_anchor"

            case "$EXE_ABS" in
                "$ORIGINAL_PREFIX_CANON"/*)
                    rel_exe="${EXE_ABS#"$ORIGINAL_PREFIX_CANON"/}"
                    EXE_ABS="$ALIAS_MOUNT/$rel_exe"
                    ;;
            esac

            # v3.6.1: translate Batocera's current working directory as well.
            # Batocera starts compressed games from /run (or /var/run)/wine/..., but
            # pressure-vessel reserves /var/run and cannot recreate that cwd inside
            # steamrt4.  Keeping EXE under the alias is not enough: bwrap also tries
            # to chdir to the inherited PWD.  Mirror the cwd inside our /userdata
            # alias so EXE, install path and cwd all live in container-shareable paths.
            pwd_canon="$(readlink -f "$PWD" 2>/dev/null || printf '%s' "$PWD")"
            case "$pwd_canon" in
                "$ORIGINAL_PREFIX_CANON")
                    UMU_CWD="$ALIAS_MOUNT"
                    ;;
                "$ORIGINAL_PREFIX_CANON"/*)
                    rel_pwd="${pwd_canon#"$ORIGINAL_PREFIX_CANON"/}"
                    UMU_CWD="$ALIAS_MOUNT/$rel_pwd"
                    ;;
                *)
                    UMU_CWD="$ALIAS_MOUNT"
                    ;;
            esac

            log "compressed_overlay=1"
            log "compressed_overlay_source=$ORIGINAL_PREFIX_CANON"
            log "compressed_overlay_alias=$ALIAS_MOUNT"
        fi
        ;;
esac

# v3.8: keep Proton's pfx on a real filesystem, but keep the game
# completely outside that pfx.  The game view is a bind of Batocera's *merged*
# OverlayFS game directory (lower + upper), exposed under /userdata so UMU /
# pressure-vessel can launch it without using /run or /var/run paths.
# This preserves the game's existing start.bat, relative paths and Batocera
# overlay semantics while keeping Proton's PFX off OverlayFS.
OVERLAY_UPPERDIR=""
OVERLAY_LOWERDIR=""
MATERIALIZED_PREFIX=""
GAMEVIEW=""
if [ "$COMPRESSED_OVERLAY" -eq 1 ]; then
    OVERLAY_MOUNT_OPTS="$(findmnt -n -o OPTIONS -T "$ORIGINAL_PREFIX_CANON" 2>/dev/null || true)"
    case ",$OVERLAY_MOUNT_OPTS," in
        *,upperdir=*) OVERLAY_UPPERDIR="${OVERLAY_MOUNT_OPTS#*upperdir=}"; OVERLAY_UPPERDIR="${OVERLAY_UPPERDIR%%,*}" ;;
    esac
    case ",$OVERLAY_MOUNT_OPTS," in
        *,lowerdir=*) OVERLAY_LOWERDIR="${OVERLAY_MOUNT_OPTS#*lowerdir=}"; OVERLAY_LOWERDIR="${OVERLAY_LOWERDIR%%,*}"; OVERLAY_LOWERDIR="${OVERLAY_LOWERDIR%%:*}" ;;
    esac
    log "runtime_lowerdir=$OVERLAY_LOWERDIR"
    log "runtime_upperdir=$OVERLAY_UPPERDIR"
    [ -d "$OVERLAY_LOWERDIR" ] || { log "ERROR: compressed-prefix lowerdir missing: $OVERLAY_LOWERDIR"; exit 78; }
    [ -d "$OVERLAY_UPPERDIR" ] || { log "ERROR: compressed-prefix upperdir missing: $OVERLAY_UPPERDIR"; exit 78; }

    case "$EXE_ABS" in
        "$ALIAS_MOUNT"/drive_c/*/*)
            REL_EXE="${EXE_ABS#"$ALIAS_MOUNT"/}"
            AFTER_DRIVEC="${REL_EXE#drive_c/}"
            GAME_DIR="${AFTER_DRIVEC%%/*}"
            GAME_REL="drive_c/$GAME_DIR"
            EXE_IN_GAME="${REL_EXE#"$GAME_REL"/}"
            ;;
        *)
            log "ERROR: compressed-prefix cannot safely derive game directory from EXE: $EXE_ABS"
            exit 79
            ;;
    esac

    # Materialize the merged Wine prefix, excluding the complete game directory.
    RUNTIME_KEY="$(printf 'compressed-pfx|%s|%s' "$compressed_anchor" "$RUNNER_DIR" | cksum | awk '{print $1}')"
    MATERIALIZED_PREFIX="/userdata/system/umu/materialized-prefixes/${alias_safe}-${RUNTIME_KEY}"
    prepare_materialized_prefix && check_materialized_space || exit 82

    COPY_START="$(date +%s)"
    log "runtime_copy_begin=$(date -Is 2>/dev/null || date)"
    if [ "$RUNTIME_REUSED" -eq 0 ]; then
    for COPY_ITEM in "$ALIAS_MOUNT"/* "$ALIAS_MOUNT"/.[!.]* "$ALIAS_MOUNT"/..?*; do
        [ -e "$COPY_ITEM" ] || [ -L "$COPY_ITEM" ] || continue
        [ "$(basename "$COPY_ITEM")" = "drive_c" ] && continue
        cp -a "$COPY_ITEM" "$MATERIALIZED_PREFIX/" 2>>"$LOG" || {
            log "ERROR: compressed-prefix prefix-root copy failed: $COPY_ITEM"; exit 80;
        }
    done
    for COPY_ITEM in "$ALIAS_MOUNT/drive_c"/* "$ALIAS_MOUNT/drive_c"/.[!.]* "$ALIAS_MOUNT/drive_c"/..?*; do
        [ -e "$COPY_ITEM" ] || [ -L "$COPY_ITEM" ] || continue
        [ "$(basename "$COPY_ITEM")" = "$GAME_DIR" ] && continue
        cp -a "$COPY_ITEM" "$MATERIALIZED_PREFIX/drive_c/" 2>>"$LOG" || {
            log "ERROR: compressed-prefix drive_c copy failed: $COPY_ITEM"; exit 80;
        }
    done
    fi
    COPY_END="$(date +%s)"
    COPY_SECONDS=$((COPY_END-COPY_START))
    COPY_SIZE="$(du -sh "$MATERIALIZED_PREFIX" 2>/dev/null | awk '{print $1}')"
    log "runtime_copy_end=$(date -Is 2>/dev/null || date)"
    log "runtime_copy_seconds=$COPY_SECONDS"
    log "runtime_materialized_size=$COPY_SIZE"
    log "runtime_real_prefix=$MATERIALIZED_PREFIX"
    log "runtime_excluded_game=$GAME_REL"

    # Bind Batocera's MERGED game directory outside the pfx. Unlike earlier split-prefix test this
    # source is ALIAS_MOUNT (the live OverlayFS view), never the SquashFS lowerdir.
    GAME_SOURCE="$ALIAS_MOUNT/$GAME_REL"
    [ -d "$GAME_SOURCE" ] || { log "ERROR: compressed-prefix merged game directory missing: $GAME_SOURCE"; exit 81; }
    if [ "$UMU_DIRECT_GAME_ENABLED" -eq 1 ]; then
        # Compressed games use the existing merged-overlay alias; .wine games
        # use their original directory. Keep prefix copying and persistence.
        GAMEVIEW="$GAME_SOURCE"
        log "runtime_gameview_bypassed=1"
    else
        GAMEVIEW_ROOT="/userdata/system/umu/gameviews/${alias_safe}-${RUNTIME_KEY}"
        GAMEVIEW="$GAMEVIEW_ROOT/$GAME_DIR"
        mkdir -p "$GAMEVIEW"
        GAMEVIEW_TARGET="$GAMEVIEW"
        GAMEVIEW_MOUNTPOINT_CREATED=1
        if ! mount --bind "$GAME_SOURCE" "$GAMEVIEW" 2>>"$LOG"; then
            log "ERROR: compressed-prefix merged gameview bind failed: $GAME_SOURCE -> $GAMEVIEW"; exit 81;
        fi
        GAMEVIEW_BOUND=1
    fi

    EXE_ABS="$GAMEVIEW/$EXE_IN_GAME"
    case "${UMU_CWD:-$ALIAS_MOUNT}" in
        "$ALIAS_MOUNT/$GAME_REL") UMU_CWD="$GAMEVIEW" ;;
        "$ALIAS_MOUNT/$GAME_REL"/*)
            REL_CWD="${UMU_CWD#"$ALIAS_MOUNT/$GAME_REL"/}"
            UMU_CWD="$GAMEVIEW/$REL_CWD"
            ;;
        *) UMU_CWD="$GAMEVIEW" ;;
    esac
    EFFECTIVE_WINEPREFIX="$MATERIALIZED_PREFIX"
    log "runtime_game_source=$GAME_SOURCE"
    log "runtime_gameview=$GAMEVIEW"
    log "runtime_gameview_fstype=$(findmnt -n -o FSTYPE -T "$GAMEVIEW" 2>/dev/null || true)"
    log "runtime_gameview_bind=$GAMEVIEW_BOUND"
    log "runtime_pfx_overlay_bypassed=1"
    log "runtime_exe=$EXE_ABS"
    log "runtime_exe_exists=$([ -e "$EXE_ABS" ] && echo 1 || echo 0)"
    log "runtime_cwd=$UMU_CWD"
fi

# v3.9.3: apply the proven v3.8 split-prefix model to ordinary .wine
# bottles as well.  Build a real runner-specific PFX excluding the top-level
# drive_c game directory, and expose the original game directory through an
# external bind-mounted gameview.  This is intentionally rebuilt on every
# launch for validation; persistence/refresh policy will be designed only if
# this proves the CachyOS 10 .wine failure is caused by the direct bottle bind.
WINE_SPLIT_PREFIX=0
if [ "$COMPRESSED_OVERLAY" -eq 0 ] && [ -n "$ORIGINAL_PREFIX_CANON" ]; then
    case "$(printf '%s' "$ORIGINAL_PREFIX_CANON" | tr '[:upper:]' '[:lower:]')" in
        *.wine)
            case "$EXE_ABS" in
                "$ORIGINAL_PREFIX_CANON"/drive_c/*/*)
                    REL_EXE="${EXE_ABS#"$ORIGINAL_PREFIX_CANON"/}"
                    AFTER_DRIVEC="${REL_EXE#drive_c/}"
                    GAME_DIR="${AFTER_DRIVEC%%/*}"
                    GAME_REL="drive_c/$GAME_DIR"
                    EXE_IN_GAME="${REL_EXE#"$GAME_REL"/}"
                    WINE_SPLIT_PREFIX=1
                    ;;
            esac
            ;;
    esac
fi

# v3.9.3: Batocera .pc games keep the game directory and Wine bottle
# separate.  The executable/cwd points at /userdata/roms/windows/<game>.pc,
# while WINEPREFIX points at .../<game>.pc.wine.  Preserve the direct prefix,
# but record the real game container as the resolver identity.
PC_GAME_PATH=""
pwd_canon_for_pc="$(readlink -f "$PWD" 2>/dev/null || printf '%s' "$PWD")"
case "$(printf '%s' "$pwd_canon_for_pc" | tr '[:upper:]' '[:lower:]')" in
    /userdata/roms/windows/*.pc|/userdata/roms/windows/*.pc/*)
        pc_rel="${pwd_canon_for_pc#/userdata/roms/windows/}"
        pc_name="${pc_rel%%.pc*}.pc"
        pc_candidate="/userdata/roms/windows/$pc_name"
        prefix_base_lc="$(basename "$ORIGINAL_PREFIX_CANON" | tr '[:upper:]' '[:lower:]')"
        pc_base_lc="$(basename "$pc_candidate" | tr '[:upper:]' '[:lower:]')"
        if [ -d "$pc_candidate" ] && [ "$prefix_base_lc" = "${pc_base_lc}.wine" ]; then
            PC_GAME_PATH="$pc_candidate"
            IDENTITY_ANCHOR="$(basename "$pc_candidate")"
            log "pc_game=1"
            log "pc_game_path=$PC_GAME_PATH"
            log "pc_prefix=$ORIGINAL_PREFIX_CANON"
        fi
        ;;
esac

# Only UWT's active, journaled old-game directory is payload rather than Wine
# prefix data. Keep this decision for both copying and persistence: excluding it
# on entry alone would let persistence remove the original rollback directory.
uwt_update_backup_name() {
    python3 - "$ORIGINAL_PREFIX_CANON" "$GAME_DIR" <<'PY'
import json
from pathlib import Path
import sys

try:
    prefix = Path(sys.argv[1]).resolve(strict=True)
    game = sys.argv[2]
    if not game or Path(game).name != game or '\n' in game or '\r' in game:
        raise ValueError('invalid game name')
    state_dir = Path('/userdata/system/ultimate-wine-toolbox/state')
    state_path = state_dir / 'wsquashfs-builder.json'
    if state_path.is_symlink():
        raise ValueError('redirected state')
    state = json.loads(state_path.read_text())
    if not isinstance(state, dict) or state.get('mode') != 'update' or Path(state['prefix']).resolve(strict=True) != prefix:
        raise ValueError('unrelated workflow')
    manifest = Path(state['metadata'])
    if (manifest.parent != state_dir or manifest.is_symlink()
            or not manifest.name.startswith('wsquashfs-update-') or manifest.suffix != '.json'):
        raise ValueError('invalid manifest')
    data = json.loads(manifest.read_text())
    backup = prefix / 'drive_c' / (game + '.bak')
    if (not isinstance(data, dict) or Path(data['prefix']).resolve(strict=True) != prefix
            or data['game_dir'] != 'drive_c/' + game
            or Path(data['game_backup']) != backup
            or data.get('committed') or data.get('game_backup_removed')
            or backup.is_symlink() or not backup.is_dir()
            or backup.resolve(strict=True) != backup):
        raise ValueError('unrecognized backup')
    print(backup.name)
except (OSError, ValueError, KeyError, TypeError, RuntimeError):
    pass  # No validated UWT update: preserve ordinary prefix semantics.
PY
}

UWT_GAME_BACKUP_NAME=""
if [ "$WINE_SPLIT_PREFIX" -eq 1 ]; then
    UWT_GAME_BACKUP_NAME="$(uwt_update_backup_name)"
    [ -z "$UWT_GAME_BACKUP_NAME" ] || log "runtime_excluded_uwt_backup=drive_c/$UWT_GAME_BACKUP_NAME"
    wine_anchor="$(basename "$ORIGINAL_PREFIX_CANON")"
    wine_safe="$(printf '%s' "$wine_anchor" | tr -c 'A-Za-z0-9._-' '_')"
    RUNTIME_KEY="$(printf 'wine-split-pfx|%s|%s' "$wine_anchor" "$RUNNER_DIR" | cksum | awk '{print $1}')"
    MATERIALIZED_PREFIX="/userdata/system/umu/materialized-prefixes/${wine_safe}-${RUNTIME_KEY}"
    prepare_materialized_prefix && check_materialized_space || exit 82

    COPY_START="$(date +%s)"
    log "wine_split_prefix=1"
    log "runtime_copy_begin=$(date -Is 2>/dev/null || date)"
    if [ "$RUNTIME_REUSED" -eq 0 ]; then
    for COPY_ITEM in "$ORIGINAL_PREFIX_CANON"/* "$ORIGINAL_PREFIX_CANON"/.[!.]* "$ORIGINAL_PREFIX_CANON"/..?*; do
        [ -e "$COPY_ITEM" ] || [ -L "$COPY_ITEM" ] || continue
        [ "$(basename "$COPY_ITEM")" = "drive_c" ] && continue
        cp -a "$COPY_ITEM" "$MATERIALIZED_PREFIX/" 2>>"$LOG" || {
            log "ERROR: wine split prefix-root copy failed: $COPY_ITEM"; exit 82;
        }
    done
    for COPY_ITEM in "$ORIGINAL_PREFIX_CANON/drive_c"/* "$ORIGINAL_PREFIX_CANON/drive_c"/.[!.]* "$ORIGINAL_PREFIX_CANON/drive_c"/..?*; do
        [ -e "$COPY_ITEM" ] || [ -L "$COPY_ITEM" ] || continue
        [ "$(basename "$COPY_ITEM")" = "$GAME_DIR" ] && continue
        [ -n "$UWT_GAME_BACKUP_NAME" ] && [ "$(basename "$COPY_ITEM")" = "$UWT_GAME_BACKUP_NAME" ] && continue
        cp -a "$COPY_ITEM" "$MATERIALIZED_PREFIX/drive_c/" 2>>"$LOG" || {
            log "ERROR: wine split drive_c copy failed: $COPY_ITEM"; exit 82;
        }
    done
    fi
    COPY_END="$(date +%s)"
    log "runtime_copy_end=$(date -Is 2>/dev/null || date)"
    log "runtime_copy_seconds=$((COPY_END-COPY_START))"
    log "runtime_materialized_size=$(du -sh "$MATERIALIZED_PREFIX" 2>/dev/null | awk '{print $1}')"
    log "runtime_real_prefix=$MATERIALIZED_PREFIX"
    log "runtime_excluded_game=$GAME_REL"

    GAME_SOURCE="$ORIGINAL_PREFIX_CANON/$GAME_REL"
    [ -d "$GAME_SOURCE" ] || { log "ERROR: wine split game directory missing: $GAME_SOURCE"; exit 83; }
    if [ "$UMU_DIRECT_GAME_ENABLED" -eq 1 ]; then
        # Compressed games use the existing merged-overlay alias; .wine games
        # use their original directory. Keep prefix copying and persistence.
        GAMEVIEW="$GAME_SOURCE"
        log "runtime_gameview_bypassed=1"
    else
        GAMEVIEW_ROOT="/userdata/system/umu/gameviews/${wine_safe}-${RUNTIME_KEY}"
        GAMEVIEW="$GAMEVIEW_ROOT/$GAME_DIR"
        mkdir -p "$GAMEVIEW"
        GAMEVIEW_TARGET="$GAMEVIEW"
        GAMEVIEW_MOUNTPOINT_CREATED=1
        if ! mount --bind "$GAME_SOURCE" "$GAMEVIEW" 2>>"$LOG"; then
            log "ERROR: wine split gameview bind failed: $GAME_SOURCE -> $GAMEVIEW"; exit 83;
        fi
        GAMEVIEW_BOUND=1
    fi

    EXE_ABS="$GAMEVIEW/$EXE_IN_GAME"
    pwd_canon="$(readlink -f "$PWD" 2>/dev/null || printf '%s' "$PWD")"
    case "$pwd_canon" in
        "$ORIGINAL_PREFIX_CANON/$GAME_REL") UMU_CWD="$GAMEVIEW" ;;
        "$ORIGINAL_PREFIX_CANON/$GAME_REL"/*)
            REL_CWD="${pwd_canon#"$ORIGINAL_PREFIX_CANON/$GAME_REL"/}"
            UMU_CWD="$GAMEVIEW/$REL_CWD"
            ;;
        *) UMU_CWD="$GAMEVIEW" ;;
    esac
    EFFECTIVE_WINEPREFIX="$MATERIALIZED_PREFIX"
    IDENTITY_ANCHOR="$wine_anchor"
    log "runtime_game_source=$GAME_SOURCE"
    log "runtime_gameview=$GAMEVIEW"
    log "runtime_gameview_fstype=$(findmnt -n -o FSTYPE -T "$GAMEVIEW" 2>/dev/null || true)"
    log "runtime_gameview_bind=$GAMEVIEW_BOUND"
    log "runtime_wine_direct_pfx_bypassed=1"
    log "runtime_exe=$EXE_ABS"
    log "runtime_exe_exists=$([ -e "$EXE_ABS" ] && echo 1 || echo 0)"
    log "runtime_cwd=$UMU_CWD"
fi

# Synchronize prefix-side changes before releasing the runtime copy. Compressed
# games write to Batocera's writable merged bottle, never to the archive. Keep
# the external game (and any owned UWT rollback directory) untouched.
persist_split_wine_prefix() {
    local source="${MATERIALIZED_PREFIX:-}"
    local target="${ORIGINAL_PREFIX_CANON:-}"
    local item name

    [ "${WINE_SPLIT_PREFIX:-0}" -eq 1 ] || [ "${COMPRESSED_OVERLAY:-0}" -eq 1 ] || return 0
    [ -n "$source" ] && [ -n "$target" ] && [ -n "${GAME_DIR:-}" ] || return 1

    case "$source" in
        /userdata/system/umu/materialized-prefixes/*) ;;
        *) log "wine_persistence_result=refused-source source=$source"; return 2 ;;
    esac
    if [ "${COMPRESSED_OVERLAY:-0}" -eq 1 ]; then
        case "$target" in
            /run/wine/*.wsquashfs|/run/wine/*.wtgz|/var/run/wine/*.wsquashfs|/var/run/wine/*.wtgz) ;;
            *) log "wine_persistence_result=refused-compressed-target target=$target"; return 3;;
        esac
        [ "$(findmnt -n -o FSTYPE -T "$target" 2>/dev/null)" = overlay ] || return 3
    else
      case "$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')" in
        *.wine) ;;
        *) log "wine_persistence_result=refused-target target=$target"; return 3 ;;
      esac
    fi

    is_prefix_root "$source" || {
        log "wine_persistence_result=invalid-source source=$source"
        return 4
    }
    is_prefix_root "$target" || {
        log "wine_persistence_result=invalid-target target=$target"
        return 5
    }

    [ -d "$target/drive_c/$GAME_DIR" ] || {
        log "wine_persistence_result=game-dir-missing target=$target/drive_c/$GAME_DIR"
        return 6
    }

    log "wine_persistence=1"
    log "wine_persistence_source=$source"
    log "wine_persistence_target=$target"
    log "wine_persistence_excluded=drive_c/$GAME_DIR"
    [ -z "${UWT_GAME_BACKUP_NAME:-}" ] || log "wine_persistence_excluded_uwt_backup=drive_c/$UWT_GAME_BACKUP_NAME"
    log "wine_persistence_begin=$(date -Is 2>/dev/null || date)"

    # Root of the prefix: make the original mirror the post-Proton materialized
    # state, except for drive_c which needs the game-directory preservation rule.
    for item in "$target"/* "$target"/.[!.]* "$target"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        name="$(basename "$item")"
        [ "$name" = "drive_c" ] && continue
        [ "${name,,}" = autorun.cmd ] && continue
        rm -rf -- "$item" 2>>"$LOG" || {
            log "wine_persistence_result=failed phase=remove-root item=$item"
            return 7
        }
    done
    for item in "$source"/* "$source"/.[!.]* "$source"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        name="$(basename "$item")"
        [ "$name" = "drive_c" ] && continue
        [ "${name,,}" = autorun.cmd ] && continue
        cp -a -- "$item" "$target/" 2>>"$LOG" || {
            log "wine_persistence_result=failed phase=copy-root item=$item"
            return 8
        }
    done

    mkdir -p -- "$target/drive_c" || return 9

    # drive_c: preserve the real game and the validated UWT rollback directory.
    # Everything else must
    # reflect the materialized PFX so ProtonFixes/Winetricks registry/files and
    # save changes outside the game directory survive the session.
    for item in "$target/drive_c"/* "$target/drive_c"/.[!.]* "$target/drive_c"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        name="$(basename "$item")"
        [ "$name" = "$GAME_DIR" ] && continue
        [ -n "${UWT_GAME_BACKUP_NAME:-}" ] && [ "$name" = "$UWT_GAME_BACKUP_NAME" ] && continue
        rm -rf -- "$item" 2>>"$LOG" || {
            log "wine_persistence_result=failed phase=remove-drive-c item=$item"
            return 10
        }
    done
    for item in "$source/drive_c"/* "$source/drive_c"/.[!.]* "$source/drive_c"/..?*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        name="$(basename "$item")"
        [ "$name" = "$GAME_DIR" ] && continue
        [ -n "${UWT_GAME_BACKUP_NAME:-}" ] && [ "$name" = "$UWT_GAME_BACKUP_NAME" ] && continue
        cp -a -- "$item" "$target/drive_c/" 2>>"$LOG" || {
            log "wine_persistence_result=failed phase=copy-drive-c item=$item"
            return 11
        }
    done

    [ -d "$target/drive_c/$GAME_DIR" ] || {
        log "wine_persistence_result=failed phase=postcheck-game-dir"
        return 12
    }

    log "wine_persistence_end=$(date -Is 2>/dev/null || date)"
    log "wine_persistence_result=success"
    return 0
}

# v3.9.2: every materialized-prefix session (.wine AND compressed)
# publishes one explicit runtime mapping. Batocera's stop path still supplies
# the original prefix, while the active wineserver belongs to the materialized
# PFX. Keep raw/canonical/alias identities so the stop wrapper never has to
# infer which namespace Batocera used.
if { [ -n "${MATERIALIZED_PREFIX:-}" ] && [ "$EFFECTIVE_WINEPREFIX" = "$MATERIALIZED_PREFIX" ]; } || [ -n "${PC_GAME_PATH:-}" ]; then
    ACTIVE_STATE_DIR="/run/umu-batocera"
    mkdir -p "$ACTIVE_STATE_DIR"
    ACTIVE_STATE_FILE="$ACTIVE_STATE_DIR/session-$$.state"
    {
        printf '%s\n' "$ORIGINAL_WINEPREFIX"
        printf '%s\n' "$ORIGINAL_PREFIX_CANON"
        printf '%s\n' "${ALIAS_MOUNT:-}"
        printf '%s\n' "$EFFECTIVE_WINEPREFIX"
        printf '%s\n' "$RUNNER_DIR"
        printf '%s\n' "$$"
    } > "$ACTIVE_STATE_FILE"
    chmod 600 "$ACTIVE_STATE_FILE" 2>/dev/null || true
    log "runtime_active_state=$ACTIVE_STATE_FILE"
    log "runtime_stop_original=$ORIGINAL_WINEPREFIX"
    log "runtime_stop_canonical=$ORIGINAL_PREFIX_CANON"
    log "runtime_stop_alias=${ALIAS_MOUNT:-}"
    log "runtime_stop_prefix=$EFFECTIVE_WINEPREFIX"
fi

# pressure-vessel does not automatically expose arbitrary /userdata paths.
# Batocera users commonly redirect saves with absolute symlinks into
# /userdata/saves/windows. Share that tree read/write so those symlinks remain
# valid inside steamrt4. Extra paths can be added with UMU_BATOCERA_EXTRA_RW.
#
# Read-only consumers (for example an external MangoHud runtime owned by
# another toolbox) can request generic pressure-vessel visibility through
# UMU_BATOCERA_EXTRA_RO. This keeps pressure-vessel details inside the UMU
# integration while callers only declare what path they need exposed.
PV_RO=""
append_pv_ro() {
    local add="$1"
    [ -n "$add" ] || return 0
    case ":$PV_RO:" in
        *":$add:"*) ;;
        *) [ -n "$PV_RO" ] && PV_RO="$PV_RO:$add" || PV_RO="$add" ;;
    esac
}

# Normalize any pre-existing pressure-vessel RO list as well: callers often
# build VAR="path:${VAR:-}", which leaves a harmless but untidy trailing ':'.
if [ -n "${PRESSURE_VESSEL_FILESYSTEMS_RO-}" ]; then
    oldIFS="$IFS"; IFS=':'
    for extra_ro in $PRESSURE_VESSEL_FILESYSTEMS_RO; do append_pv_ro "$extra_ro"; done
    IFS="$oldIFS"
fi
if [ -n "${UMU_BATOCERA_EXTRA_RO-}" ]; then
    oldIFS="$IFS"; IFS=':'
    for extra_ro in $UMU_BATOCERA_EXTRA_RO; do append_pv_ro "$extra_ro"; done
    IFS="$oldIFS"
fi
export PRESSURE_VESSEL_FILESYSTEMS_RO="$PV_RO"
log "PRESSURE_VESSEL_FILESYSTEMS_RO=$PRESSURE_VESSEL_FILESYSTEMS_RO"

PV_RW="${PRESSURE_VESSEL_FILESYSTEMS_RW-}"
append_pv_rw() {
    local add="$1"
    [ -n "$add" ] || return 0
    case ":$PV_RW:" in
        *":$add:"*) ;;
        *) [ -n "$PV_RW" ] && PV_RW="$PV_RW:$add" || PV_RW="$add" ;;
    esac
}
[ -d /userdata/saves ] && append_pv_rw /userdata/saves
# Batocera can point graphics caches outside the directories shared by UMU.
# Preserve those paths (and existing caches), but make them visible in the
# Steam Runtime. Disabled, relative and missing paths are not mount requests.
expose_graphics_caches() {
    local key path resolved
    for key in VKD3D_SHADER_CACHE_PATH DXVK_STATE_CACHE_PATH DXVK_SHADER_CACHE_PATH MESA_SHADER_CACHE_DIR MESA_GLSL_CACHE_DIR __GL_SHADER_DISK_CACHE_PATH; do
        path="${!key-}"
        case "$path" in
            ''|0) continue ;;
            /*) ;;
            *) log "graphics_cache_skip=$key (relative path)"; continue ;;
        esac
        case "$path" in
            *:*|*$'\n'*) log "graphics_cache_skip=$key (invalid mount path)"; continue ;;
        esac
        if [ ! -d "$path" ]; then
            log "graphics_cache_skip=$key (directory absent): $path"
            continue
        fi
        resolved="$(readlink -f -- "$path")" || continue
        case "$resolved" in
            /|/userdata|/userdata/system) log "graphics_cache_skip=$key (broad mount path)"; continue ;;
            *:*|*$'\n'*) log "graphics_cache_skip=$key (invalid resolved path)"; continue ;;
        esac
        append_pv_rw "$path"
        # Also expose a symlink's target when it lives outside shared paths.
        [ "$resolved" = "$path" ] || append_pv_rw "$resolved"
        log "graphics_cache_rw=$key: $path"
    done
}
# Per-game ENV takes priority over the persistent Toolbox setting. Only read
# literal data from config; never source it as shell code. Default stays on.
graphics_cache_sharing="${UMU_GRAPHICS_CACHE_SHARING-}"
if [ -z "$graphics_cache_sharing" ]; then
    graphics_cache_sharing="$(cat /userdata/system/umu/toolbox/config/graphics-cache-sharing 2>/dev/null || true)"
fi
case "$graphics_cache_sharing" in
    0|1) ;;
    *) graphics_cache_sharing=1 ;;
esac
log "graphics_cache_sharing=$graphics_cache_sharing"
if [ "$graphics_cache_sharing" = 1 ]; then
    expose_graphics_caches
fi
unset UMU_GRAPHICS_CACHE_SHARING
if [ -n "${UMU_BATOCERA_EXTRA_RW-}" ]; then
    oldIFS="$IFS"; IFS=':'
    for extra_rw in $UMU_BATOCERA_EXTRA_RW; do append_pv_rw "$extra_rw"; done
    IFS="$oldIFS"
fi
export PRESSURE_VESSEL_FILESYSTEMS_RW="$PV_RW"
log "PRESSURE_VESSEL_FILESYSTEMS_RW=$PRESSURE_VESSEL_FILESYSTEMS_RW"

# v3.3: Batocera's WINEPREFIX is the source of truth whenever it already points
# to a real Wine bottle. This deliberately preserves Batocera's own persistence
# layout without hard-coding a version:
#   v42  -> /userdata/system/wine-bottles/windows/<game>.wine
#   v43+ -> /userdata/system/wine-bottles/windows/<runner>/<game>.wine
# If WINEPREFIX is missing/not initialized, fall back to structural detection
# around the executable for older/atypical launch paths.
EMBEDDED_PREFIX=""
PREFIX_SOURCE="none"
if is_prefix_root "$EFFECTIVE_WINEPREFIX"; then
    EMBEDDED_PREFIX="$EFFECTIVE_WINEPREFIX"
    if [ "$COMPRESSED_OVERLAY" -eq 1 ]; then
        PREFIX_SOURCE="batocera-compressed-overlay-alias"
    else
        PREFIX_SOURCE="batocera-wineprefix"
    fi
else
    EMBEDDED_PREFIX="$(find_embedded_prefix "$EXE_ABS" 2>/dev/null || true)"
    if [ -n "$EMBEDDED_PREFIX" ]; then
        PREFIX_SOURCE="executable-fallback"
    fi
fi

GAME_BASENAME="$(basename "$EXE_ABS")"
GAME_STEM="${GAME_BASENAME%.*}"
GAME_SAFE="$(printf '%s' "$GAME_STEM" | tr -c 'A-Za-z0-9._-' '_')"

if [ -n "$EMBEDDED_PREFIX" ]; then
    # v3.3: one compatdata adapter per Batocera bottle, NOT per executable.
    # autorun.cmd, manual selector and maintenance launches can therefore all
    # refer to the same pfx adapter/shadercache. The real persistent data still
    # lives in the Batocera wine-bottle via pfx -> WINEPREFIX.
    anchor="${IDENTITY_ANCHOR:-$(basename "$EMBEDDED_PREFIX")}"
    # v3.8.1: isolate Proton compatdata metadata per runner for every embedded
    # Batocera bottle. The real .wine prefix remains shared/persistent and is
    # still bind-mounted as compatdata/pfx; only Proton's adapter metadata and
    # shader/cache state get a runner-specific directory. This prevents a test
    # with CachyOS/GE/GDK version A from upgrading or downgrading the compatdata
    # metadata subsequently consumed by runner B.
    ident="embedded|$anchor|$(basename "$RUNNER_DIR")"
    if [ "$COMPRESSED_OVERLAY" -eq 1 ] && [ -n "${GAMEVIEW:-}" ]; then
        ident="compressed|$anchor|$(basename "$RUNNER_DIR")"
    fi
    prefix_stem="${anchor%.wine}"
    GAME_SAFE="$(printf '%s' "$prefix_stem" | tr -c 'A-Za-z0-9._-' '_')"
else
    ident="standalone|$EXE_ABS"
fi
GAME_KEY="$(printf '%s' "$ident" | cksum | awk '{print $1}')"
PREFIX="$COMPAT_ROOT/${GAME_SAFE}-${GAME_KEY}"
mkdir -p "$PREFIX" "$UMU_CACHE"

MODE="standard"
if [ -n "$EMBEDDED_PREFIX" ]; then
    MODE="embedded-prefix-bind"

    # v3.4: do NOT use a symlink for compatdata/pfx.
    # GE-Proton can normalize a symlinked pfx into "pfx -> .", which turns the
    # whole compatdata directory into the active Wine prefix. Saves then land in
    # /userdata/system/umu/compatdata/.../drive_c instead of the Batocera bottle.
    #
    # A bind mount makes pfx a real directory view of Batocera's WINEPREFIX:
    # every write through compatdata/pfx is physically a write to the bottle.
    PFX_MOUNT="$PREFIX/pfx"

    # Clean legacy v3.x pfx symlinks. In particular pfx -> . must never survive.
    if [ -L "$PFX_MOUNT" ]; then
        log "legacy_pfx_symlink=$(readlink "$PFX_MOUNT" 2>/dev/null || true)"
        rm -f "$PFX_MOUNT"
    fi

    # If an old standard compatdata left a real pfx directory, preserve it once
    # rather than destroying user data, then create a clean mountpoint.
    if [ -d "$PFX_MOUNT" ]; then
        if grep -qs " $PFX_MOUNT " /proc/mounts 2>/dev/null; then
            umount "$PFX_MOUNT" 2>>"$LOG" || true
        elif [ "$(find "$PFX_MOUNT" -mindepth 1 -maxdepth 1 2>/dev/null | head -1)" ]; then
            mv "$PFX_MOUNT" "$PREFIX/pfx.pre-v34-$stamp"
        fi
    fi
    mkdir -p "$PFX_MOUNT"

    # v3.8: for compressed Batocera prefixes, keep the /userdata alias
    # only for EXE/CWD visibility inside pressure-vessel. Do NOT stack the pfx
    # bind on top of that alias bind. Bind Proton's compatdata/pfx from the real
    # materialized prefix. Recent GE/GDK runners can otherwise fail when the PFX
    # itself is an OverlayFS view, even though the same game works as .wine.
    PFX_BIND_SOURCE="$EMBEDDED_PREFIX"
    if { [ "$COMPRESSED_OVERLAY" -eq 1 ] || [ "${WINE_SPLIT_PREFIX:-0}" -eq 1 ]; } && [ -n "${MATERIALIZED_PREFIX:-}" ]; then
        PFX_BIND_SOURCE="$MATERIALIZED_PREFIX"
    elif [ "$COMPRESSED_OVERLAY" -eq 1 ] && [ -n "$ORIGINAL_PREFIX_CANON" ]; then
        PFX_BIND_SOURCE="$ORIGINAL_PREFIX_CANON"
    fi
    log "pfx_bind_source=$PFX_BIND_SOURCE"

    # The bottle must be writable. This also validates Batocera's merged
    # wine-bottle view for .wsquashfs without hard-coding v42/v43 paths.
    if ! touch "$PFX_BIND_SOURCE/.umu-write-test-$$" 2>>"$LOG"; then
        log "ERROR: Batocera WINEPREFIX is not writable: $PFX_BIND_SOURCE"
        exit 74
    fi
    rm -f "$PFX_BIND_SOURCE/.umu-write-test-$$"

    if ! mount --bind "$PFX_BIND_SOURCE" "$PFX_MOUNT" 2>>"$LOG"; then
        log "ERROR: bind mount failed: $PFX_BIND_SOURCE -> $PFX_MOUNT"
        exit 75
    fi
    PFX_BOUND=1

    # Prevent Proton's initial default_pfx population over an existing bottle.
    # Keep the guard in the compatdata root and also in the mounted pfx for
    # compatibility with Proton variants that inspect either location.
    touch "$PREFIX/creation_sync_guard"
    touch "$PFX_MOUNT/creation_sync_guard"
    touch "$PREFIX/tracked_files"
    rm -f "$PREFIX/.umu-standard-prefix"
else
    touch "$PREFIX/.umu-standard-prefix"
fi

export HOME="$UMU_HOME"
export XDG_CACHE_HOME="$UMU_CACHE"
export WINEPREFIX="$PREFIX"
export PROTONPATH="$RUNNER_DIR"

UMU_RESOLVER="/userdata/system/umu/toolbox/umu-gameid-resolver.py"
UMU_DATABASE="/userdata/system/umu/toolbox/data/umu-database.csv"
if [ ! -s "$UMU_RESOLVER" ] || [ ! -s "$UMU_DATABASE" ]; then
    UMU_RESOLVER="$RUNNER_DIR/umu-batocera/umu-gameid-resolver.py"
    UMU_DATABASE="$RUNNER_DIR/umu-batocera/data/umu-database.csv"
fi
UMU_GAME_PATH=""
UMU_RESOLVER_MATCH="FALLBACK"
UMU_RESOLVER_PATH_MATCH=""
UMU_RESOLVER_TITLE=""
UMU_RESOLVER_DB_TITLE=""
UMU_RESOLVER_POLICY="NONE"
export GAMEID="umu-default"
export STORE=""

# v3.7.14: use the resolved bottle/game identity, not a literal escaped
# parameter expression.  The previous \${...} tests were always non-empty,
# so ordinary .wine launches incorrectly resolved to /userdata/roms/windows/.
if [ -n "${PC_GAME_PATH:-}" ]; then
    UMU_GAME_PATH="$PC_GAME_PATH"
elif [ -n "${IDENTITY_ANCHOR:-}" ]; then
    UMU_GAME_PATH="/userdata/roms/windows/$IDENTITY_ANCHOR"
elif [ -n "${anchor:-}" ]; then
    UMU_GAME_PATH="/userdata/roms/windows/$anchor"
fi

if [ -s "$UMU_RESOLVER" ] && [ -n "$UMU_GAME_PATH" ]; then
    UMU_RESOLVER_OUT="$(python3 "$UMU_RESOLVER" "$UMU_GAME_PATH" --database "$UMU_DATABASE" --protonfixes "$RUNNER_DIR/protonfixes" 2>>"$LOG")"
    UMU_RESOLVER_RC=$?
    if [ "$UMU_RESOLVER_RC" -eq 0 ]; then
        while IFS='=' read -r resolver_key resolver_value; do
            case "$resolver_key" in
                GAMEID|STORE|MATCH|PATH_MATCH|TITLE|DB_TITLE|STORE_POLICY)
                    resolver_value="$(printf '%s\n' "$resolver_value" | python3 -c 'import ast,sys; s=sys.stdin.read().rstrip("\n"); print(ast.literal_eval(s))' 2>>"$LOG")" || continue ;;
                *) continue ;;
            esac
            case "$resolver_key" in
                GAMEID) GAMEID="$resolver_value" ;;
                STORE) STORE="$resolver_value" ;;
                MATCH) UMU_RESOLVER_MATCH="$resolver_value" ;;
                PATH_MATCH) UMU_RESOLVER_PATH_MATCH="$resolver_value" ;;
                TITLE) UMU_RESOLVER_TITLE="$resolver_value" ;;
                DB_TITLE) UMU_RESOLVER_DB_TITLE="$resolver_value" ;;
                STORE_POLICY) UMU_RESOLVER_POLICY="$resolver_value" ;;
            esac
        done <<< "$UMU_RESOLVER_OUT"
        export GAMEID STORE
    else
        log "[UMU-Resolver] resolver failed rc=$UMU_RESOLVER_RC; using umu-default"
    fi
else
    log "[UMU-Resolver] resolver unavailable or game identity missing; using umu-default"
fi
log "[UMU-Resolver] game_path=$UMU_GAME_PATH"
log "[UMU-Resolver] title=$UMU_RESOLVER_TITLE"
log "[UMU-Resolver] db_title=$UMU_RESOLVER_DB_TITLE"
log "[UMU-Resolver] match=$UMU_RESOLVER_MATCH"
log "[UMU-Resolver] path_match=$UMU_RESOLVER_PATH_MATCH"
log "[UMU-Resolver] GAMEID=$GAMEID"
log "[UMU-Resolver] STORE=$STORE"
log "[UMU-Resolver] store_policy=$UMU_RESOLVER_POLICY"

export UMU_LOG="\${UMU_LOG:-debug}"

log "launch_kind=application"
log "mode=umu-$MODE"
log "exe=$exe"
log "exe_abs=$EXE_ABS"
log "embedded_prefix=$EMBEDDED_PREFIX"
log "prefix_source=$PREFIX_SOURCE"
log "compatdata=$PREFIX"
log "pfx_target=$([ -n "${PFX_BIND_SOURCE:-}" ] && printf '%s' "$PFX_BIND_SOURCE" || { [ -n "$EMBEDDED_PREFIX" ] && printf '%s' "$EMBEDDED_PREFIX" || readlink "$PREFIX/pfx" 2>/dev/null || true; })"
log "pfx_bind=${PFX_BOUND:-0}"
log "compressed_overlay=${COMPRESSED_OVERLAY:-0}"
log "compressed_overlay_alias=${ALIAS_MOUNT:-}"
log "identity=$ident"
log "GAMEID=$GAMEID"
log "PROTONPATH=$PROTONPATH"
log "UMU_RUN=$UMU_RUN"

# v3.9.3: the split .wine gameview is also outside the original bottle.
if [ "${WINE_SPLIT_PREFIX:-0}" -eq 1 ]; then
    log "original_pwd=$PWD"
    log "umu_cwd=$UMU_CWD"
    if ! cd "$UMU_CWD"; then
        log "ERROR: cannot cd to split .wine gameview: $UMU_CWD"
        exit 84
    fi
fi

# v3.6.1: pressure-vessel inherits the caller cwd. For compressed games we must
# enter the alias path before starting UMU, otherwise bwrap still tries to chdir
# back into /var/run/wine/... and aborts even though EXE itself is under /userdata.
if [ "$COMPRESSED_OVERLAY" -eq 1 ]; then
    UMU_CWD="${UMU_CWD:-$ALIAS_MOUNT}"
    if [ ! -d "$UMU_CWD" ]; then
        log "ERROR: translated UMU cwd does not exist: $UMU_CWD"
        exit 77
    fi
    log "original_pwd=$PWD"
    log "umu_cwd=$UMU_CWD"
    if ! cd "$UMU_CWD"; then
        log "ERROR: cannot cd to translated UMU cwd: $UMU_CWD"
        exit 77
    fi
fi

if ! python3 "$RUNNER_DIR/umu-batocera/prefix-isolation.py" "$EFFECTIVE_WINEPREFIX" \
    --runners "$(dirname "$RUNNER_DIR")" >>"$LOG" 2>&1; then
    log "FATAL: prefix isolation failed; launch refused"
    exit 94
fi

if [ ! -s "$UMU_RUN" ]; then
    log "ERROR: umu-run missing or empty: $UMU_RUN"
    exit 127
fi
if [ ! -s "$RUNNER_DIR/proton" ]; then
    log "ERROR: proton missing or empty: $RUNNER_DIR/proton"
    exit 127
fi

if ! prepare_direct_save_copy; then
    log "ERROR: direct save compatibility failed; launch refused"
    exit 95
fi
if ! expose_c_game_path; then
    log "ERROR: cannot expose stable C game path; launch refused"
    exit 96
fi
if [ "$C_GAME_PATH_BOUND" -eq 1 ] && [ "$UMU_DIRECT_GAME_ENABLED" -eq 0 ]; then
    cd "$UMU_CWD" || { log "ERROR: cannot enter C game working directory"; exit 96; }
fi
UMU_EXE="$exe"
if [ "$COMPRESSED_OVERLAY" -eq 1 ] || [ "${WINE_SPLIT_PREFIX:-0}" -eq 1 ]; then
    UMU_EXE="$EXE_ABS"
fi
log "umu_exe=$UMU_EXE"
if [ "$RUNTIME_TRACKED" -eq 1 ]; then
    python3 "$RUNTIME_HELPER" running "$MATERIALIZED_PREFIX" --pid "$$" >>"$LOG" 2>&1 || exit 97
    RUNTIME_SAFE_TO_REMOVE=0
fi
# v3.8: real materialized pfx + external merged Batocera gameview.
python3 "$ROOT_BRIDGE" "$UMU_RUN" "$UMU_EXE" "${launch_args[@]}" >> "$LOG" 2>&1
rc=$?
# Leave the bind-mounted alias before EXIT cleanup so normal umount is not kept
# busy merely by this wrapper shell's current working directory.
if [ "$COMPRESSED_OVERLAY" -eq 1 ] || [ "${WINE_SPLIT_PREFIX:-0}" -eq 1 ]; then
    cd /userdata 2>>"$LOG" || cd / 2>>"$LOG" || true
fi
cleanup_c_game_path || log "WARNING: C game cleanup incomplete before persistence"

if [ "${WINE_SPLIT_PREFIX:-0}" -eq 1 ] || [ "$COMPRESSED_OVERLAY" -eq 1 ]; then
    if [ "$C_GAME_PATH_BOUND" -eq 0 ]; then
        persist_split_wine_prefix
        persist_rc=$?
    else
        persist_rc=15
    fi
    log "wine_persistence_rc=$persist_rc"
    if [ "$persist_rc" -ne 0 ]; then
        log "WARNING: prefix persistence failed; runtime retained for recovery=$MATERIALIZED_PREFIX"
    else
        RUNTIME_SAFE_TO_REMOVE=1
    fi
fi

log "exit=$rc"
exit "$rc"

